{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ClientInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "InitializeCapabilities": {
      "description": "Client-declared capabilities negotiated during initialize.",
      "properties": {
        "experimentalApi": {
          "default": false,
          "description": "Opt into receiving experimental API methods and fields.",
          "type": "boolean"
        },
        "optOutNotificationMethods": {
          "description": "Exact notification method names that should be suppressed for this connection (for example `thread/started`).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "remoteClient": {
          "anyOf": [
            {
              "$ref": "#/definitions/RemoteClientCapabilities"
            },
            {
              "type": "null"
            }
          ],
          "description": "Client surface affordances that affect how remote gateways should route work to this connection."
        }
      },
      "type": "object"
    },
    "RemoteClientCapabilities": {
      "properties": {
        "answersApprovals": {
          "default": false,
          "description": "The client can answer approval requests from the user.",
          "type": "boolean"
        },
        "receivesCommandOutput": {
          "default": false,
          "description": "The client can receive command output notifications.",
          "type": "boolean"
        },
        "rendersDiffs": {
          "default": false,
          "description": "The client can render file diffs in a reviewable form.",
          "type": "boolean"
        },
        "supportsFileAttachments": {
          "default": false,
          "description": "The client can submit file attachments or other binary user input.",
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/definitions/InitializeCapabilities"
        },
        {
          "type": "null"
        }
      ]
    },
    "clientInfo": {
      "$ref": "#/definitions/ClientInfo"
    }
  },
  "required": [
    "clientInfo"
  ],
  "title": "InitializeParams",
  "type": "object"
}