{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "WorkspaceGoal": {
      "properties": {
        "completedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "priority": {
          "format": "int64",
          "type": "integer"
        },
        "source": {
          "$ref": "#/definitions/WorkspaceGoalSource"
        },
        "status": {
          "$ref": "#/definitions/WorkspaceGoalStatus"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        },
        "workspaceKey": {
          "type": "string"
        }
      },
      "required": [
        "createdAt",
        "id",
        "objective",
        "priority",
        "source",
        "status",
        "updatedAt",
        "workspaceKey"
      ],
      "type": "object"
    },
    "WorkspaceGoalSource": {
      "enum": [
        "human",
        "orchestrator"
      ],
      "type": "string"
    },
    "WorkspaceGoalStatus": {
      "enum": [
        "active",
        "paused",
        "complete",
        "archived"
      ],
      "type": "string"
    }
  },
  "properties": {
    "goal": {
      "$ref": "#/definitions/WorkspaceGoal"
    }
  },
  "required": [
    "goal"
  ],
  "title": "WorkspaceGoalUpdatedNotification",
  "type": "object"
}